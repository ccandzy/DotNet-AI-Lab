<Window x:Class="AiChatClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:helpers="clr-namespace:AiChatClient.Helpers"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:AiChatClient.Models"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:system="clr-namespace:System.Windows;assembly=PresentationFramework"
        xmlns:views="clr-namespace:AiChatClient.Views"
        Title="AI Chat"
        Width="1200"
        Height="800"
        MinWidth="960"
        MinHeight="620"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStyle="None"
        mc:Ignorable="d">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            CornerRadius="10"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="WindowButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="#D7E5E7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="WindowButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="WindowButtonBorder" Property="Background" Value="#285158" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="WindowButtonBorder" Property="Background" Value="#356A70" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonBase" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="15,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionBorder" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionBorder" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ActionBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton"
               BasedOn="{StaticResource ActionButtonBase}"
               TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#3B7D83" />
            <Setter Property="BorderBrush" Value="#3B7D83" />
        </Style>

        <Style x:Key="SecondaryButton"
               BasedOn="{StaticResource ActionButtonBase}"
               TargetType="Button">
            <Setter Property="Foreground" Value="#365B63" />
            <Setter Property="Background" Value="#EDF3F4" />
            <Setter Property="BorderBrush" Value="#D5E2E4" />
        </Style>

        <Style x:Key="SidebarButton"
               BasedOn="{StaticResource ActionButtonBase}"
               TargetType="Button">
            <Setter Property="Foreground" Value="#C9DDDE" />
            <Setter Property="Background" Value="#214B52" />
            <Setter Property="BorderBrush" Value="#2B5D63" />
        </Style>

        <Style x:Key="SidebarPrimaryButton"
               BasedOn="{StaticResource ActionButtonBase}"
               TargetType="Button">
            <Setter Property="Foreground" Value="#17393F" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="White" />
        </Style>

        <Style x:Key="CleanComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="11,9" />
            <Setter Property="Margin" Value="3,2" />
            <Setter Property="Foreground" Value="#2E4850" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ComboItemBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                CornerRadius="5">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ComboItemBorder" Property="Background" Value="#EEF6F6" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ComboItemBorder" Property="Background" Value="#DFEFF0" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Native ComboBox template keeps SelectedItem and ItemsSource behavior reliable.  -->
        <Style x:Key="CleanComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#29444C" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#C7D8DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource CleanComboBoxItemStyle}" />
        </Style>

        <Style x:Key="ComposerTextBox" TargetType="TextBox">
            <Setter Property="MinHeight" Value="78" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#203C44" />
            <Setter Property="Background" Value="#FBFDFD" />
            <Setter Property="BorderBrush" Value="#C7DADD" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="ConversationListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="ConversationItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Foreground" Value="#C7DADC" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ConversationBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ConversationBorder" Property="Background" Value="#214B52" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ConversationBorder" Property="Background" Value="#2F6B72" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1D3E45" />
        </Style>

        <Style x:Key="SectionText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#274850" />
        </Style>

        <Style x:Key="CaptionText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#788F96" />
        </Style>

        <Style x:Key="SidebarCaptionText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#86A9AD" />
        </Style>

        <DataTemplate x:Key="UserMessageTemplate" DataType="{x:Type models:ChatMessage}">
            <Grid Margin="0,5">
                <Border MaxWidth="700"
                        Padding="14,10"
                        HorizontalAlignment="Right"
                        Background="#DDF0F0"
                        CornerRadius="9">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   FontSize="14"
                                   Foreground="#25454D"
                                   Text="{Binding Content}"
                                   TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1"
                                   Margin="0,5,0,0"
                                   HorizontalAlignment="Right"
                                   Style="{StaticResource CaptionText}"
                                   Text="{Binding Timestamp, StringFormat=HH:mm:ss}" />
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AssistantMessageTemplate" DataType="{x:Type models:ChatMessage}">
            <Grid Margin="0,5">
                <Border MaxWidth="700"
                        Padding="14,11"
                        HorizontalAlignment="Left"
                        Background="White"
                        BorderBrush="#E0EAEC"
                        BorderThickness="1"
                        CornerRadius="9">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <views:MarkdownView Grid.Row="0" Markdown="{Binding Content}" />
                        <TextBlock Grid.Row="1"
                                   Margin="0,6,0,0"
                                   HorizontalAlignment="Right"
                                   Style="{StaticResource CaptionText}"
                                   Text="{Binding Timestamp, StringFormat=HH:mm:ss}" />
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <helpers:ChatMessageTemplateSelector x:Key="MessageTemplateSelector"
                                             AssistantTemplate="{StaticResource AssistantMessageTemplate}"
                                             UserTemplate="{StaticResource UserMessageTemplate}" />
    </Window.Resources>

    <Border Margin="6"
            Background="#F3F7F7"
            BorderBrush="#C8D9DC"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Global application bar  -->
            <Border Grid.Row="0"
                    Background="#173A40"
                    CornerRadius="9,9,0,0">
                <Grid Margin="16,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="27"
                            Height="27"
                            VerticalAlignment="Center"
                            Background="#4C8C91"
                            CornerRadius="8">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Text="AI" />
                    </Border>
                    <StackPanel Grid.Column="1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Text="AI Chat" />
                        <TextBlock FontSize="10"
                                   Foreground="#A9C9CC"
                                   Text="智能对话工作台" />
                    </StackPanel>
                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <Button Click="MinimizeWindowButton_Click"
                                Content="—"
                                Style="{StaticResource WindowButtonStyle}" />
                        <Grid>
                            <Button Click="MaximizeWindowButton_Click"
                                    Content="□">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource WindowButtonStyle}" TargetType="Button">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Maximized">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Click="RestoreWindowButton_Click"
                                    Content="❐">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource WindowButtonStyle}" TargetType="Button">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Maximized">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                        <Button Click="CloseWindowButton_Click"
                                Content="×"
                                FontSize="20"
                                Style="{StaticResource WindowButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="252" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="238" />
                </Grid.ColumnDefinitions>

                <!--  Navigation: conversation management lives here.  -->
                <Border Grid.Column="0"
                        Padding="16,18,14,16"
                        Background="#173A40"
                        CornerRadius="0,0,0,9">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBlock Foreground="White"
                                       Style="{StaticResource SectionText}"
                                       Text="会话" />
                            <TextBlock HorizontalAlignment="Right"
                                       Style="{StaticResource SidebarCaptionText}"
                                       Text="CONVERSATIONS" />
                        </Grid>
                        <Button Grid.Row="1"
                                Margin="0,16,0,14"
                                Command="{Binding NewConversationCommand}"
                                Content="＋  新会话"
                                Style="{StaticResource SidebarPrimaryButton}" />
                        <ListBox Grid.Row="2"
                                 DisplayMemberPath="Title"
                                 ItemContainerStyle="{StaticResource ConversationItemStyle}"
                                 ItemsSource="{Binding Conversations}"
                                 SelectedItem="{Binding CurrentConversation, Mode=TwoWay}"
                                 Style="{StaticResource ConversationListStyle}" />
                        <StackPanel Grid.Row="3"
                                    Margin="0,14,0,0"
                                    Orientation="Horizontal">
                            <Button Width="100"
                                    Margin="0,0,7,0"
                                    Command="{Binding RenameConversationCommand}"
                                    Content="重命名"
                                    Style="{StaticResource SidebarButton}" />
                            <Button Width="100"
                                    Command="{Binding DeleteConversationCommand}"
                                    Content="删除"
                                    Style="{StaticResource SidebarButton}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  Conversation workspace  -->
                <Grid Grid.Column="1" Margin="18,16,18,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="126" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource TitleText}" Text="对话" />
                            <TextBlock Margin="0,2,0,0"
                                       Style="{StaticResource CaptionText}"
                                       Text="与 AI 进行连续、可追踪的交流" />
                        </StackPanel>
                        <Button Width="72"
                                Height="34"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Command="{Binding ClearCommand}"
                                Content="清空"
                                Style="{StaticResource SecondaryButton}" />
                    </Grid>

                    <Border Grid.Row="1"
                            Padding="18,14"
                            Background="#F8FBFB"
                            BorderBrush="#E0EAEC"
                            BorderThickness="1"
                            CornerRadius="9">
                        <ScrollViewer x:Name="MessagesScrollViewer"
                                      Background="Transparent"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="MessagesListBox"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          ClipToBounds="True"
                                          ItemTemplateSelector="{StaticResource MessageTemplateSelector}"
                                          ItemsSource="{Binding Messages}" />
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Row="2"
                            Margin="0,12,0,0"
                            Padding="14"
                            Background="White"
                            BorderBrush="#E0EAEC"
                            BorderThickness="1"
                            CornerRadius="9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="112" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="InputTextBox"
                                     Grid.Column="0"
                                     AcceptsReturn="True"
                                     Style="{StaticResource ComposerTextBox}"
                                     Text="{Binding CurrentInput, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" />
                            <StackPanel Grid.Column="1"
                                        Margin="14,0,0,0"
                                        VerticalAlignment="Center">
                                <Button Width="96"
                                        Command="{Binding SendCommand}"
                                        Content="发送"
                                        Style="{StaticResource PrimaryButton}" />
                                <Button Width="96"
                                        Margin="0,7,0,0"
                                        Command="{Binding StopCommand}"
                                        Content="停止"
                                        Style="{StaticResource SecondaryButton}"
                                        Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock Margin="0,7,0,0"
                                           HorizontalAlignment="Center"
                                           Style="{StaticResource CaptionText}"
                                           Text="Enter 发送 · Shift+Enter 换行"
                                           TextAlignment="Center" />
                                <TextBlock Margin="0,3,0,0"
                                           HorizontalAlignment="Center"
                                           Style="{StaticResource CaptionText}"
                                           Text="思考中..."
                                           Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!--  Inspector: provider/model/role configuration is isolated here.  -->
                <Border Grid.Column="2"
                        Padding="18,18,18,16"
                        Background="White"
                        BorderBrush="#E0EAEC"
                        BorderThickness="1,0,0,0"
                        CornerRadius="0,0,9,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Style="{StaticResource SectionText}"
                                   Text="AI 配置" />
                        <TextBlock Grid.Row="1"
                                   Margin="0,4,0,22"
                                   Style="{StaticResource CaptionText}"
                                   Text="为当前对话选择服务和角色" />

                        <StackPanel Grid.Row="2">
                            <TextBlock Margin="0,0,0,6"
                                       Style="{StaticResource CaptionText}"
                                       Text="厂家" />
                            <ComboBox DisplayMemberPath="Name"
                                      ItemsSource="{Binding AIProviders}"
                                      SelectedItem="{Binding SelectedAIProvider, Mode=TwoWay}"
                                      Style="{StaticResource CleanComboBox}" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Margin="0,18,0,0">
                            <TextBlock Margin="0,0,0,6"
                                       Style="{StaticResource CaptionText}"
                                       Text="模型" />
                            <ComboBox DisplayMemberPath="Name"
                                      ItemsSource="{Binding AIModels}"
                                      SelectedItem="{Binding SelectedAIModel, Mode=TwoWay}"
                                      Style="{StaticResource CleanComboBox}" />
                        </StackPanel>
                        <StackPanel Grid.Row="4"
                                    Margin="0,18,0,0"
                                    VerticalAlignment="Top">
                            <TextBlock Margin="0,0,0,6"
                                       Style="{StaticResource CaptionText}"
                                       Text="角色" />
                            <ComboBox DisplayMemberPath="Name"
                                      IsEnabled="{Binding IsRoleSwitchEnabled}"
                                      ItemsSource="{Binding Roles}"
                                      SelectedItem="{Binding SelectedRole, Mode=TwoWay}"
                                      Style="{StaticResource CleanComboBox}" />
                            <Border Margin="0,22,0,0"
                                    Padding="12"
                                    Background="#F3F8F8"
                                    CornerRadius="7">
                                <TextBlock FontSize="12"
                                           Foreground="#638087"
                                           Text="角色在会话开始前可切换。会话产生消息后，角色选择会被锁定。"
                                           TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
