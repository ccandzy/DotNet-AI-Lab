        <Grid Margin="0,13,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Command="{Binding OpenSerialCommand}" Content="打开串口" Style="{StaticResource SecondaryButton}"/><Button Grid.Column="2" Command="{Binding StartMeasurementCommand}" Content="▶  开始" Style="{StaticResource PrimaryButton}"/><Button Grid.Column="4" Command="{Binding StopMeasurementCommand}" Content="▣  停止" Style="{StaticResource SecondaryButton}"/></Grid><Button Margin="0,6,0,0" Command="{Binding CloseSerialCommand}" Content="◴  关闭串口" Style="{StaticResource SecondaryButton}"/>
        <TextBlock Margin="0,11,0,0" FontSize="10" Foreground="#4D7382" Text="{Binding SerialReceiveStatus}" TextWrapping="Wrap"/><TextBlock Margin="0,4,0,0" MaxHeight="44" FontFamily="Consolas" FontSize="9" Foreground="#7B919E" Text="{Binding SerialLastFrame}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" ToolTip="{Binding SerialLastFrame}"/>
        <Grid Margin="0,13,0,6"><TextBlock Style="{StaticResource Label}" Text="实时数据（原始值）"/><Button Width="64" Height="30" HorizontalAlignment="Right" Padding="6,0" Command="{Binding ClearMeasurementCommand}" Content="⌫ 清屏" Style="{StaticResource SecondaryButton}"/></Grid><TextBox x:Name="MeasurementTextBox" Height="150" Padding="9" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="10" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Text="{Binding MeasurementText,Mode=OneWay}" TextChanged="MeasurementTextBox_OnTextChanged"/><TextBlock Margin="0,8,0,0" FontSize="10" Foreground="#7B919E" TextWrapping="Wrap" Text="对话口令：大激发开始测量 / 大激发停止测量"/>
      </StackPanel></ScrollViewer></Border>
      <ToggleButton x:Name="DeviceDrawerToggle" Grid.Column="2" Grid.ColumnSpan="5" Panel.ZIndex="30" Margin="0,7,142,0" HorizontalAlignment="Right" VerticalAlignment="Top" IsChecked="False" Style="{StaticResource DrawerToggle}"/>
      <!-- window controls -->
      <StackPanel Grid.Column="2" Grid.ColumnSpan="5" Margin="0,7,9,0" HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal"><Button Click="MinimizeWindowButton_Click" Content="&#xE921;" Style="{StaticResource ChromeButton}"/><Grid><Button Click="MaximizeWindowButton_Click" Content="&#xE922;"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ChromeButton}"><Style.Triggers><DataTrigger Binding="{Binding WindowState,RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Click="RestoreWindowButton_Click" Content="&#xE923;"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ChromeButton}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding WindowState,RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></Grid><Button Click="CloseWindowButton_Click" Content="&#xE8BB;" Style="{StaticResource ChromeButton}"/></StackPanel>
    </Grid>
  </Border>
</Window>
