<Window x:Class="AiChatClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:AiChatClient.Views"
        Title="codex"
        Width="1440"
        Height="860"
        MinWidth="960"
        MinHeight="620"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStyle="None"
        mc:Ignorable="d">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            CornerRadius="10"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!--  Codex palette: monochrome, flat, subtle  -->
        <SolidColorBrush x:Key="BgWindow" Color="#ffffff" />
        <SolidColorBrush x:Key="BgSidebar" Color="#f7f7f8" />
        <SolidColorBrush x:Key="BgHover" Color="#ececec" />
        <SolidColorBrush x:Key="BgSelected" Color="#e6e6e6" />
        <SolidColorBrush x:Key="BorderSubtle" Color="#ececec" />
        <SolidColorBrush x:Key="TextPrimary" Color="#0d0d0d" />
        <SolidColorBrush x:Key="TextSecondary" Color="#8e8e93" />

        <!--  Window caption buttons  -->
        <Style x:Key="WindowButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="WindowButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="WindowButtonBorder" Property="Background" Value="{StaticResource BgHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseWindowButtonStyle" BasedOn="{StaticResource WindowButtonStyle}" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseButtonBorder"
                                Background="Transparent"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseButtonBorder" Property="Background" Value="{StaticResource BgSelected}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Base button: flat, monochrome  -->
        <Style x:Key="ActionButtonBase" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionBorder" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionBorder" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ActionBorder" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Secondary: white with hairline border  -->
        <Style x:Key="SecondaryButton"
               BasedOn="{StaticResource ActionButtonBase}"
               TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="#ffffff" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!--  Ghost: borderless gray text  -->
        <Style x:Key="GhostButton"
               BasedOn="{StaticResource ActionButtonBase}"
               TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!--  Quiet sidebar action: transparent, tinted on hover  -->
        <Style x:Key="SidebarQuietButton" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="QuietBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="QuietBorder" Property="Background" Value="{StaticResource BgHover}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="QuietBorder" Property="Background" Value="{StaticResource BgSelected}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Compact action inside knowledge file cards  -->
        <Style x:Key="SidebarMiniButton" TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="MiniBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MiniBorder" Property="Background" Value="{StaticResource BgSelected}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Add-file row: white hairline card, left-aligned glyph  -->
        <Style x:Key="AddFileButton" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="#ffffff" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="AddFileBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="AddFileBorder" Property="Background" Value="#f2f2f3" />
                                <Setter TargetName="AddFileBorder" Property="BorderBrush" Value="#d9d9de" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Sidebar section expander: full-width header row, rotating chevron  -->
        <Style x:Key="SidebarExpander" TargetType="Expander">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton Cursor="Hand"
                                          Focusable="False"
                                          Content="{TemplateBinding Header}"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="SectionHeaderBorder"
                                                Padding="16,8"
                                                Background="Transparent"
                                                CornerRadius="6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="Chevron"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="13"
                                                           Foreground="{StaticResource TextSecondary}"
                                                           RenderTransformOrigin="0.5,0.5"
                                                           Text="›">
                                                    <TextBlock.RenderTransform>
                                                        <RotateTransform Angle="0" />
                                                    </TextBlock.RenderTransform>
                                                </TextBlock>
                                                <ContentPresenter Margin="8,0,0,0"
                                                                  VerticalAlignment="Center"
                                                                  RecognizesAccessKey="True" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="SectionHeaderBorder" Property="Background" Value="{StaticResource BgHover}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="90" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ComboBox items  -->
        <Style x:Key="CleanComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ComboItemBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                CornerRadius="6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ComboItemBorder" Property="Background" Value="{StaticResource BgHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ComboItemBorder" Property="Background" Value="{StaticResource BgSelected}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CleanComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,0,28,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource CleanComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          ClickMode="Press"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboToggleBorder"
                                                Background="#ffffff"
                                                BorderBrush="{StaticResource BorderSubtle}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <Path Data="M 0,0 L 4,4 L 8,0"
                                                  HorizontalAlignment="Right"
                                                  Margin="0,0,12,0"
                                                  Stroke="{StaticResource TextSecondary}"
                                                  StrokeThickness="1.5"
                                                  VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ComboToggleBorder" Property="BorderBrush" Value="#d9d9de" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ComboToggleBorder" Property="BorderBrush" Value="#c9c9cf" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              IsHitTestVisible="False" />
                            <Popup x:Name="Popup"
                                   AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Margin="0,4,0,0"
                                        Background="#ffffff"
                                        BorderBrush="{StaticResource BorderSubtle}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer Margin="4"
                                                  MaxHeight="220"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Composer: plain field inside the rounded wrapper  -->
        <Style x:Key="ComposerTextBox" TargetType="TextBox">
            <Setter Property="MinHeight" Value="60" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}" />
        </Style>

        <Style x:Key="ConversationListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>

        <!--  Thread rows: flat gray hover/selected, no color  -->
        <Style x:Key="ConversationItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="6,1" />
            <Setter Property="Foreground" Value="#3c3c43" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ConversationBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ConversationBorder" Property="Background" Value="{StaticResource BgHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ConversationBorder" Property="Background" Value="{StaticResource BgSelected}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Text styles  -->
        <Style x:Key="TitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>

        <Style x:Key="SectionText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>

        <Style x:Key="CaptionText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        </Style>

        <Style x:Key="SidebarCaptionText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#b0b0b5" />
        </Style>

        <!--  Codex-like label for panel headers  -->
        <Style x:Key="PanelHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        </Style>

        <!--  Small field label  -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        </Style>

        <!--  Monochrome slider: hairline track, round white thumb  -->
        <Style x:Key="MonoSlider" TargetType="Slider">
            <Setter Property="Height" Value="20" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource BgHover}"
                                    CornerRadius="2" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4"
                                                        Background="#3c3c43"
                                                        CornerRadius="2" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4"
                                                        Background="Transparent"
                                                        CornerRadius="2" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Width="14"
                                                        Height="14"
                                                        Background="#ffffff"
                                                        BorderBrush="#d9d9de"
                                                        BorderThickness="1"
                                                        CornerRadius="7" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Quiet checkbox: small rounded square, dark check on white  -->
        <Style x:Key="QuietCheckBox" TargetType="CheckBox">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Background="Transparent" Orientation="Horizontal">
                            <Border x:Name="CheckBoxBorder"
                                    Width="16"
                                    Height="16"
                                    VerticalAlignment="Center"
                                    Background="#ffffff"
                                    BorderBrush="#c9c9cf"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <Path x:Name="CheckMark"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M 1.5,5 L 4.5,8 L 9.5,2"
                                      Stroke="#3c3c43"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeThickness="1.6"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="#8e8e93" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="#3c3c43" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Rounded field input  -->
        <Style x:Key="FieldTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="#ffffff" />
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="FieldBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="#d9d9de" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="#c9c9cf" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Pill-style tab header  -->
        <Style x:Key="QuietTabItem" TargetType="TabItem">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Margin="0,0,6,0"
                                Padding="12,6"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource BgHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#ffffff" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BgWindow}"
            BorderBrush="{StaticResource BorderSubtle}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Caption: minimal, transparent, blends into sidebar  -->
            <Border Grid.Row="0"
                    Background="{StaticResource BgSidebar}"
                    BorderBrush="{StaticResource BorderSubtle}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="10,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="290" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  App mark: "> _" glyph like Codex  -->
                    <StackPanel Grid.Column="0"
                                Margin="20,0,0,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <Border Width="24"
                                Height="24"
                                Background="#0d0d0d"
                                CornerRadius="7">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       Foreground="White"
                                       Text="&gt;_" />
                        </Border>
                        <TextBlock Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   Text="codex" />
                        <!--  Collapse left sidebar  -->
                        <Button x:Name="LeftPanelToggleButton"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Click="LeftPanelToggleButton_Click"
                                Content="«"
                                FontSize="15"
                                Style="{StaticResource WindowButtonStyle}"
                                ToolTip="隐藏会话栏" />
                    </StackPanel>

                    <!--  Center: current thread title  -->
                    <TextBlock Grid.Column="1"
                               Margin="16,0"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondary}"
                               Text="{Binding CurrentConversation.Title, TargetNullValue=新对话}"
                               TextTrimming="CharacterEllipsis" />

                    <!--  Collapse right inspector  -->
                    <Button x:Name="RightPanelToggleButton"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Click="RightPanelToggleButton_Click"
                            Content="»"
                            FontSize="15"
                            Style="{StaticResource WindowButtonStyle}"
                            ToolTip="隐藏配置栏" />

                    <!--  Window controls  -->
                    <StackPanel Grid.Column="3"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <Button Click="MinimizeWindowButton_Click"
                                Content="—"
                                Style="{StaticResource WindowButtonStyle}" />
                        <Grid>
                            <Button Click="MaximizeWindowButton_Click" Content="□">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource WindowButtonStyle}" TargetType="Button">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Maximized">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Click="RestoreWindowButton_Click" Content="❐">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource WindowButtonStyle}" TargetType="Button">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Maximized">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                        <Button Click="CloseWindowButton_Click"
                                Content="✕"
                                Style="{StaticResource CloseWindowButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  ================ Left: threads sidebar (Codex style)  ================  -->
                <Border x:Name="LeftPanel"
                        Grid.Column="0"
                        Width="290"
                        Background="{StaticResource BgSidebar}"
                        BorderBrush="{StaticResource BorderSubtle}"
                        BorderThickness="0,0,1,0"
                        ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  New thread  -->
                        <Border Grid.Row="0" Padding="12,12,12,6">
                            <Button Command="{Binding NewConversationCommand}"
                                    Style="{StaticResource SidebarQuietButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="13" Text="＋" />
                                    <TextBlock Margin="8,0,0,0" FontSize="12" Text="新会话" />
                                </StackPanel>
                            </Button>
                        </Border>

                        <!--  Thread list  -->
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0"
                                       Margin="18,10,18,4"
                                       Style="{StaticResource PanelHeader}"
                                       Text="对话" />
                            <ListBox Grid.Row="1"
                                     IsEnabled="{Binding CanManageConversations}"
                                     DisplayMemberPath="Title"
                                     ItemContainerStyle="{StaticResource ConversationItemStyle}"
                                     ItemsSource="{Binding Conversations}"
                                     SelectedItem="{Binding CurrentConversation, Mode=TwoWay}"
                                     Style="{StaticResource ConversationListStyle}" />
                            <!--  Thread actions: quiet hover-tinted pair  -->
                            <Grid Grid.Row="2" Margin="12,6,12,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Command="{Binding RenameConversationCommand}"
                                        Content="重命名"
                                        Style="{StaticResource SidebarQuietButton}" />
                                <Button Grid.Column="2"
                                        Command="{Binding DeleteConversationCommand}"
                                        Content="删除"
                                        Style="{StaticResource SidebarQuietButton}" />
                            </Grid>
                        </Grid>

                        <!--  Knowledge: collapsible footer section  -->
                        <Border Grid.Row="2"
                                BorderBrush="{StaticResource BorderSubtle}"
                                BorderThickness="0,1,0,0">
                            <Expander Style="{StaticResource SidebarExpander}">
                                <Expander.Header>
                                    <TextBlock FontSize="12"
                                               FontWeight="Medium"
                                               Foreground="{StaticResource TextSecondary}"
                                               Text="知识库" />
                                </Expander.Header>
                                <StackPanel Margin="14,10,14,12">
                                    <Button Command="{Binding AddKnowledgeFileCommand}"
                                            Style="{StaticResource AddFileButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontSize="13"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       Text="＋" />
                                            <TextBlock Margin="8,0,0,0" Text="添加文件" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Margin="2,10,0,0"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondary}"
                                               Text="正在处理文件…"
                                               Visibility="{Binding IsImportingKnowledge, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <Button Margin="0,6,0,0"
                                            Command="{Binding CancelKnowledgeImportCommand}"
                                            Content="取消导入"
                                            Style="{StaticResource SidebarQuietButton}"
                                            Visibility="{Binding IsImportingKnowledge, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <ItemsControl MaxHeight="160"
                                                  Margin="0,10,0,0"
                                                  ItemsSource="{Binding KnowledgeFiles}">
                                        <ItemsControl.Template>
                                            <ControlTemplate TargetType="ItemsControl">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <ItemsPresenter />
                                                </ScrollViewer>
                                            </ControlTemplate>
                                        </ItemsControl.Template>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,6"
                                                        Padding="10,9"
                                                        ToolTip="{Binding SourcePath}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#ffffff" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
                                                            <Setter Property="BorderThickness" Value="1" />
                                                            <Setter Property="CornerRadius" Value="8" />
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="BorderBrush" Value="#d9d9de" />
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <TextBlock FontSize="12"
                                                                   FontWeight="Medium"
                                                                   Foreground="{StaticResource TextPrimary}"
                                                                   Text="{Binding FileName}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Margin="0,2,0,0"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource TextSecondary}"
                                                                   Text="{Binding Status}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                                                            <TextBlock FontSize="10"
                                                                       Foreground="#b0b0b5"
                                                                       Text="{Binding ChunkCount, StringFormat=Chunk：{0}}" />
                                                            <TextBlock Margin="8,0,0,0"
                                                                       FontSize="10"
                                                                       Foreground="#b0b0b5"
                                                                       Text="{Binding IsVectorized, StringFormat=向量化：{0}}" />
                                                        </StackPanel>
                                                        <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                                                            <Button Command="{Binding DataContext.RebuildKnowledgeFileCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                    CommandParameter="{Binding}"
                                                                    Content="重建"
                                                                    Style="{StaticResource SidebarMiniButton}" />
                                                            <Button Margin="6,0,0,0"
                                                                    Command="{Binding DataContext.DeleteKnowledgeFileCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                    CommandParameter="{Binding}"
                                                                    Content="删除"
                                                                    Style="{StaticResource SidebarMiniButton}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>
                        </Border>
                    </Grid>
                </Border>

                <!--  ================ Center: transcript + composer  ================  -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Transcript: no card, no border, plain white like Codex  -->
                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!--  Status line: quiet, auto-hides when empty  -->
                        <Border Grid.Row="0"
                                Padding="0"
                                Background="#fdf6e3">
                            <TextBlock Margin="24,8"
                                       FontSize="12"
                                       Foreground="#8a6d00"
                                       Text="{Binding StatusMessage}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding StatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Border>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="760" MaxWidth="760" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <views:ChatTranscriptView Grid.Column="1" Messages="{Binding Messages}" />
                        </Grid>
                    </Grid>

                    <StackPanel Grid.Row="1">
                        <!--  Tool call history: quiet hairline strip, hidden when empty  -->
                        <Border Margin="24,0,24,8"
                                Padding="12,8"
                                Background="#ffffff"
                                BorderBrush="{StaticResource BorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Visibility="{Binding HasToolCalls, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock FontSize="11"
                                           Foreground="{StaticResource TextSecondary}"
                                           Text="本次使用的工具" />
                                <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding CurrentToolCalls}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock FontSize="12"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       Text="{Binding StringFormat='•  {0}'}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <!--  Composer: single rounded shell like Codex  -->
                        <Border Margin="24,0,24,16"
                            Padding="0"
                            Background="#ffffff"
                            BorderBrush="#d9d9de"
                            BorderThickness="1"
                            CornerRadius="16">
                        <Grid Margin="18,14,14,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  Input line  -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="InputTextBox"
                                         Grid.Column="0"
                                         AcceptsReturn="True"
                                         Style="{StaticResource ComposerTextBox}"
                                         Text="{Binding CurrentInput, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" />
                                <!--  Circular send button  -->
                                <Button Grid.Column="1"
                                        Width="32"
                                        Height="32"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Bottom"
                                        Command="{Binding SendCommand}"
                                        Cursor="Hand"
                                        ToolTip="发送">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="SendBorder"
                                                    Background="#ffffff"
                                                    BorderBrush="#d9d9de"
                                                    BorderThickness="1"
                                                    CornerRadius="16">
                                                <TextBlock HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="13"
                                                           Foreground="{StaticResource TextPrimary}"
                                                           Text="↑" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="SendBorder" Property="Background" Value="{StaticResource BgSidebar}" />
                                                    <Setter TargetName="SendBorder" Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
                                                    <Setter TargetName="SendBorder" Property="TextBlock.Foreground" Value="{StaticResource TextSecondary}" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="SendBorder" Property="Background" Value="#f2f2f3" />
                                                    <Setter TargetName="SendBorder" Property="BorderBrush" Value="#c9c9cf" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <!--  Divider + option row  -->
                            <Border Grid.Row="1"
                                    Margin="0,10,0,8"
                                    BorderBrush="{StaticResource BorderSubtle}"
                                    BorderThickness="0,1,0,0" />
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <CheckBox VerticalAlignment="Center"
                                              Content="RAG"
                                              Foreground="{StaticResource TextSecondary}"
                                              IsChecked="{Binding IsRagEnabled, Mode=TwoWay}"
                                              IsEnabled="{Binding CanConfigureRequest}" />
                                    <CheckBox Margin="16,0,0,0"
                                              VerticalAlignment="Center"
                                              Content="工具"
                                              Foreground="{StaticResource TextSecondary}"
                                              IsChecked="{Binding IsToolsEnabled, Mode=TwoWay}"
                                              IsEnabled="{Binding CanConfigureRequest}" />
                                    <TextBlock Margin="16,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="11"
                                               Foreground="#b0b0b5"
                                               Text="Enter 发送 · Shift+Enter 换行" />
                                    <TextBlock Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="11"
                                               Foreground="#b0b0b5"
                                               Text="生成中…"
                                               Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Width="64"
                                            Height="28"
                                            Command="{Binding ClearCommand}"
                                            Content="清空"
                                            Style="{StaticResource SecondaryButton}" />
                                    <Button Width="64"
                                            Height="28"
                                            Margin="8,0,0,0"
                                            Command="{Binding StopCommand}"
                                            Content="停止"
                                            Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Style="{StaticResource SecondaryButton}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                    </StackPanel>
                </Grid>

                <!--  ================ Right: config inspector (quiet, flat)  ================  -->
                <Border x:Name="RightPanel"
                        Grid.Column="2"
                        Width="300"
                        Background="{StaticResource BgSidebar}"
                        BorderBrush="{StaticResource BorderSubtle}"
                        BorderThickness="1,0,0,0"
                        ClipToBounds="True">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20,16,20,16">

                            <!--  AI config  -->
                            <TextBlock Style="{StaticResource PanelHeader}" Text="配置" />
                            <TextBlock Margin="0,4,0,12"
                                       FontSize="11"
                                       Foreground="#b0b0b5"
                                       Text="会话开始前可修改厂家、模型与角色" />

                            <TextBlock Margin="0,0,0,5"
                                       Style="{StaticResource FieldLabel}"
                                       Text="厂家" />
                            <ComboBox DisplayMemberPath="Name"
                                      IsEnabled="{Binding IsConversationConfigurationEditable}"
                                      ItemsSource="{Binding AIProviders}"
                                      SelectedItem="{Binding SelectedAIProvider, Mode=TwoWay}"
                                      Style="{StaticResource CleanComboBox}" />

                            <TextBlock Margin="0,12,0,5"
                                       Style="{StaticResource FieldLabel}"
                                       Text="模型" />
                            <ComboBox DisplayMemberPath="Name"
                                      IsEnabled="{Binding IsConversationConfigurationEditable}"
                                      ItemsSource="{Binding AIModels}"
                                      SelectedItem="{Binding SelectedAIModel, Mode=TwoWay}"
                                      Style="{StaticResource CleanComboBox}" />

                            <TextBlock Margin="0,12,0,5"
                                       Style="{StaticResource FieldLabel}"
                                       Text="角色" />
                            <ComboBox DisplayMemberPath="Name"
                                      IsEnabled="{Binding IsConversationConfigurationEditable}"
                                      ItemsSource="{Binding Roles}"
                                      SelectedItem="{Binding SelectedRole, Mode=TwoWay}"
                                      Style="{StaticResource CleanComboBox}" />

                            <!--  Generation settings  -->
                            <Border Margin="0,20,0,12"
                                    BorderBrush="{StaticResource BorderSubtle}"
                                    BorderThickness="0,1,0,0" />
                            <TextBlock Style="{StaticResource PanelHeader}" Text="生成参数" />

                            <Grid Margin="0,8,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Temperature" />
                                <TextBlock Grid.Column="1"
                                           FontSize="11"
                                           Foreground="{StaticResource TextPrimary}"
                                           Text="{Binding Temperature, StringFormat={}{0:0.00}, TargetNullValue=默认}" />
                            </Grid>
                            <CheckBox Margin="0,0,0,8"
                                      Content="使用 Provider 默认值"
                                      IsChecked="{Binding UseProviderDefaultTemperature, Mode=TwoWay}"
                                      Style="{StaticResource QuietCheckBox}" />
                            <Slider LargeChange="0.25"
                                    Maximum="1"
                                    Minimum="0"
                                    SmallChange="0.05"
                                    Value="{Binding Temperature, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <Slider.Style>
                                    <Style BasedOn="{StaticResource MonoSlider}" TargetType="Slider">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UseProviderDefaultTemperature}" Value="True">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Slider.Style>
                            </Slider>

                            <Grid Margin="0,14,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Top P" />
                                <TextBlock Grid.Column="1"
                                           FontSize="11"
                                           Foreground="{StaticResource TextPrimary}"
                                           Text="{Binding TopP, StringFormat={}{0:0.00}, TargetNullValue=默认}" />
                            </Grid>
                            <CheckBox Margin="0,0,0,8"
                                      Content="使用 Provider 默认值"
                                      IsChecked="{Binding UseProviderDefaultTopP, Mode=TwoWay}"
                                      Style="{StaticResource QuietCheckBox}" />
                            <Slider LargeChange="0.25"
                                    Maximum="1"
                                    Minimum="0"
                                    SmallChange="0.05"
                                    Value="{Binding TopP, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <Slider.Style>
                                    <Style BasedOn="{StaticResource MonoSlider}" TargetType="Slider">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UseProviderDefaultTopP}" Value="True">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Slider.Style>
                            </Slider>

                            <TextBlock Margin="0,14,0,5"
                                       Style="{StaticResource FieldLabel}"
                                       Text="Max Tokens" />
                            <TextBox Style="{StaticResource FieldTextBox}"
                                     Text="{Binding MaxTokens, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <!--  MCP  -->
                            <Border Margin="0,20,0,12"
                                    BorderBrush="{StaticResource BorderSubtle}"
                                    BorderThickness="0,1,0,0" />
                            <TextBlock Style="{StaticResource PanelHeader}" Text="MCP" />
                            <Grid Margin="0,8,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontSize="11"
                                           Foreground="#b0b0b5"
                                           Text="{Binding McpConnectionStatus}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1"
                                           FontSize="11"
                                           Foreground="{StaticResource TextPrimary}"
                                           Text="{Binding McpServerDisplayName}" />
                            </Grid>

                            <StackPanel Orientation="Horizontal">
                                <Button Width="72"
                                        Command="{Binding ConnectMcpCommand}"
                                        Content="连接"
                                        Style="{StaticResource SecondaryButton}" />
                                <Button Width="72"
                                        Margin="8,0,0,0"
                                        Command="{Binding DisconnectMcpCommand}"
                                        Content="断开"
                                        Style="{StaticResource SecondaryButton}" />
                            </StackPanel>

                            <TabControl Margin="0,12,0,0"
                                        Background="Transparent"
                                        BorderThickness="0">
                                <TabItem Header="Tools" Style="{StaticResource QuietTabItem}">
                                    <DockPanel Margin="0,10">
                                        <Button DockPanel.Dock="Bottom"
                                                Margin="0,10,0,0"
                                                Command="{Binding CallMcpToolCommand}"
                                                Content="调用选中 Tool"
                                                Style="{StaticResource SecondaryButton}" />
                                        <ListBox Padding="2"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 ItemContainerStyle="{StaticResource ConversationItemStyle}"
                                                 ItemsSource="{Binding McpTools}"
                                                 SelectedItem="{Binding SelectedMcpTool, Mode=TwoWay}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="2,2">
                                                        <TextBlock FontSize="12"
                                                                   FontWeight="Medium"
                                                                   Foreground="{StaticResource TextPrimary}"
                                                                   Text="{Binding Name}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Margin="0,2,0,0"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource TextSecondary}"
                                                                   Text="{Binding Description}"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                </TabItem>
                                <TabItem Header="Resources" Style="{StaticResource QuietTabItem}">
                                    <DockPanel Margin="0,10">
                                        <Button DockPanel.Dock="Bottom"
                                                Margin="0,10,0,0"
                                                Command="{Binding ReadMcpResourceCommand}"
                                                Content="读取选中 Resource"
                                                Style="{StaticResource SecondaryButton}" />
                                        <ListBox Padding="2"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 ItemContainerStyle="{StaticResource ConversationItemStyle}"
                                                 ItemsSource="{Binding McpResources}"
                                                 SelectedItem="{Binding SelectedMcpResource, Mode=TwoWay}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="2,2">
                                                        <TextBlock FontSize="12"
                                                                   FontWeight="Medium"
                                                                   Foreground="{StaticResource TextPrimary}"
                                                                   Text="{Binding Name}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Margin="0,2,0,0"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource TextSecondary}"
                                                                   Text="{Binding Uri}"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Margin="0,2,0,0"
                                                                   FontSize="10"
                                                                   Foreground="#b0b0b5"
                                                                   Text="{Binding MimeType}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                </TabItem>
                            </TabControl>

                            <Border Margin="0,14,0,0"
                                    Padding="12"
                                    Background="#ffffff"
                                    BorderBrush="{StaticResource BorderSubtle}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <StackPanel>
                                    <TextBlock FontSize="11"
                                               Foreground="{StaticResource TextSecondary}"
                                               Text="结果 / 资源正文" />
                                    <ScrollViewer MaxHeight="140"
                                                  Margin="0,8,0,0"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <TextBlock FontSize="12"
                                                   Foreground="#3c3c43"
                                                   Text="{Binding McpResult}"
                                                   TextWrapping="Wrap" />
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
