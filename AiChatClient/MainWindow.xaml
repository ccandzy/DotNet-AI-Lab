<Window x:Class="AiChatClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:helpers="clr-namespace:AiChatClient.Helpers"
        xmlns:local="clr-namespace:AiChatClient"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:AiChatClient.Models"
        xmlns:views="clr-namespace:AiChatClient.Views"
        Title="MainWindow"
        Width="1024"
        Height="800"
        mc:Ignorable="d">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!--  User message template: plain TextBlock  -->
        <DataTemplate x:Key="UserMessageTemplate" DataType="{x:Type models:ChatMessage}">
            <Grid Margin="0,4">
                <Border MaxWidth="580"
                        Padding="12,8"
                        HorizontalAlignment="Right"
                        Background="#DCF3FF"
                        CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Text="{Binding Content}"
                                   TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1"
                                   Margin="0,4,0,0"
                                   HorizontalAlignment="Right"
                                   FontSize="10"
                                   Foreground="Gray"
                                   Text="{Binding Timestamp, StringFormat=HH:mm:ss}" />
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <!--  Assistant message template: Markdown rendering  -->
        <DataTemplate x:Key="AssistantMessageTemplate" DataType="{x:Type models:ChatMessage}">
            <Grid Margin="0,4">
                <Border MaxWidth="580"
                        Padding="10"
                        HorizontalAlignment="Left"
                        Background="#F3F4F6"
                        CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <views:MarkdownView Grid.Row="0" Markdown="{Binding Content}" />
                        <TextBlock Grid.Row="1"
                                   Margin="0,6,0,0"
                                   HorizontalAlignment="Right"
                                   FontSize="10"
                                   Foreground="Gray"
                                   Text="{Binding Timestamp, StringFormat=HH:mm:ss}" />
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <!--  Template selector  -->
        <helpers:ChatMessageTemplateSelector x:Key="MessageTemplateSelector"
                                             AssistantTemplate="{StaticResource AssistantMessageTemplate}"
                                             UserTemplate="{StaticResource UserMessageTemplate}" />
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Left panel: conversations  -->
        <Border Grid.Row="0"
                Grid.RowSpan="3"
                Grid.Column="0"
                Margin="0,0,8,0"
                Padding="8"
                Background="#FAFAFA"
                CornerRadius="8">
            <DockPanel LastChildFill="True">
                <Button Height="30"
                        Margin="0,0,0,8"
                        Command="{Binding NewConversationCommand}"
                        Content="新会话"
                        DockPanel.Dock="Top" />
                <StackPanel Margin="0">
                    <ListBox Height="650"
                             DisplayMemberPath="Title"
                             ItemsSource="{Binding Conversations}"
                             SelectedItem="{Binding CurrentConversation, Mode=TwoWay}" />
                    <StackPanel Margin="0,8,0,0"
                                HorizontalAlignment="Stretch"
                                Orientation="Horizontal">
                        <Button Width="80"
                                Margin="0,0,8,0"
                                Click="RenameConversation_Click"
                                Content="重命名" />
                        <Button Width="80"
                                Command="{Binding DeleteConversationCommand}"
                                Content="删除" />
                    </StackPanel>
                </StackPanel>
                <Border DockPanel.Dock="Bottom" />
            </DockPanel>
        </Border>

        <Border Grid.Row="0"
                Grid.Column="1"
                Grid.ColumnSpan="1"
                Margin="0,0,0,8"
                Padding="12"
                Background="#F2F2F2"
                CornerRadius="8">
            <DockPanel>
                <TextBlock VerticalAlignment="Center"
                           FontSize="18"
                           FontWeight="Bold"
                           Text="AI Chat" />
                <Button Width="72"
                        Height="30"
                        Command="{Binding ClearCommand}"
                        Content="清空"
                        DockPanel.Dock="Right" />
                <ComboBox Width="220"
                          Margin="8,0,8,0"
                          DisplayMemberPath="Name"
                          DockPanel.Dock="Right"
                          IsEnabled="{Binding IsRoleSwitchEnabled}"
                          ItemsSource="{Binding Roles}"
                          SelectedItem="{Binding SelectedRole, Mode=TwoWay}" />
                <Border DockPanel.Dock="Right" />
            </DockPanel>
        </Border>

        <Border Grid.Row="1"
                Grid.Column="1"
                Padding="8"
                BorderBrush="#E5E5E5"
                BorderThickness="1"
                CornerRadius="8">
            <ScrollViewer x:Name="MessagesScrollViewer"
                          Background="Transparent"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="MessagesListBox"
                              Background="Transparent"
                              BorderThickness="0"
                              ClipToBounds="True"
                              ItemTemplateSelector="{StaticResource MessageTemplateSelector}"
                              ItemsSource="{Binding Messages}" />
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2"
              Grid.Column="1"
              Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="InputTextBox"
                     Grid.Column="0"
                     MinHeight="70"
                     MaxHeight="140"
                     AcceptsReturn="True"
                     Text="{Binding CurrentInput, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />

            <StackPanel Grid.Column="1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Bottom">
                <Button Width="90"
                        Height="34"
                        Command="{Binding SendCommand}"
                        Content="发送" />
                <Button Width="90"
                        Height="34"
                        Margin="0,6,0,0"
                        Command="{Binding StopCommand}"
                        Content="停止"
                        Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Margin="0,6,0,0"
                           HorizontalAlignment="Center"
                           Foreground="Gray"
                           Text="思考中..."
                           Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
